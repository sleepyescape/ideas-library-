{
  "extraKnownMarketplaces": {
    "ideas-library": {
      "source": {
        "source": "github",
        "repo": "sleepyescape/ideas-library-"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "headroom-marketplace": {
      "source": {
        "source": "github",
        "repo": "headroomlabs-ai/headroom"
      }
    },
    "one-skill-to-rule-them-all": {
      "source": {
        "source": "github",
        "repo": "rebelytics/one-skill-to-rule-them-all"
      }
    }
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-mem@thedotmack": true,
    "headroom@headroom-marketplace": true,
    "task-observer@one-skill-to-rule-them-all": true,
    "cartoon-reel@ideas-library": true,
    "hello-ideas@ideas-library": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tools/session-setup.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
